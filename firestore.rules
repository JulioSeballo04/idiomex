rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Função auxiliar: verifica se o usuário logado é o professor vinculado ao aluno {alunoId}
    function ehProfessorDoAluno(alunoId) {
      return exists(/databases/$(database)/documents/usuarios/$(alunoId)) &&
        get(/databases/$(database)/documents/usuarios/$(alunoId)).data.professorId == request.auth.uid;
    }

    // Função auxiliar: verifica se o usuário logado é aluno vinculado ao professor {professorId}
    function souAlunoDesteProfessor(professorId) {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.professorId == professorId;
    }

    // Função auxiliar: o código de professor {codigo} existe e aponta pro professor {professorId}
    function codigoAponta(codigo, professorId) {
      return codigo is string &&
        exists(/databases/$(database)/documents/codigosProfessor/$(codigo)) &&
        get(/databases/$(database)/documents/codigosProfessor/$(codigo)).data.professorId == professorId;
    }

    // Vínculo do aluno com um professor. Ao gravar um professorId, o aluno precisa
    // informar em "codigoVinculo" o código desse professor — é a prova de que ele
    // recebeu o código, sem poder se vincular a qualquer professor pelo console.
    function vinculoValido(dados) {
      return dados.get('professorId', null) == null ||
        codigoAponta(dados.get('codigoVinculo', null), dados.professorId);
    }

    // Índice "código do professor -> uid do professor". É por aqui que o cadastro
    // do aluno (e a troca de professor) descobre a quem o código pertence, lendo um
    // único documento pelo código — sem precisar consultar a coleção "usuarios", o
    // que antes obrigava a deixar nome e e-mail de TODOS os professores visíveis
    // pra qualquer conta logada.
    match /codigosProfessor/{codigo} {
      // Só leitura direta pelo código (get). Listar a coleção fica proibido, pra
      // ninguém conseguir baixar todos os códigos de uma vez.
      allow get: if request.auth != null;
      allow list: if false;

      // Só o próprio professor cria a entrada do SEU código (o que está gravado no
      // perfil dele). getAfter() enxerga o perfil mesmo quando ele é criado no mesmo
      // lote de gravação, como acontece no cadastro. Como não existe "update", um
      // código que já pertence a alguém nunca pode ser tomado por outra conta.
      allow create: if request.auth != null &&
        request.resource.data.professorId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tipo == "professor" &&
        getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.codigoProfessor == codigo;

      // O dono pode apagar a entrada (exclusão da conta do professor)
      allow delete: if request.auth != null && resource.data.professorId == request.auth.uid;
    }

    // "Plano" do aluno, definido pelo professor: quantas aulas por semana ele pode
    // marcar (0 = sem limite) e quantas reposições o professor já concedeu. Guarda o
    // professorId junto: se o aluno trocar de professor, o plano antigo não vale mais.
    //
    // O plano é por idioma ("porIdioma": {en: {...}, ja: {...}}); os campos de fora
    // são do plano antigo, de antes de ser por idioma.
    function numerosDoPlanoValidos(p) {
      return p.aulasPorSemana is int && p.aulasPorSemana >= 0 && p.aulasPorSemana <= 14 &&
        p.reposicoesConcedidas is int && p.reposicoesConcedidas >= 0 && p.reposicoesConcedidas <= 1000;
    }

    function planoDoIdiomaValido(porIdioma, idioma) {
      return !(idioma in porIdioma) || (
        porIdioma[idioma] is map &&
        porIdioma[idioma].keys().hasOnly(["aulasPorSemana", "reposicoesConcedidas"]) &&
        numerosDoPlanoValidos(porIdioma[idioma]));
    }

    function porIdiomaValido(porIdioma) {
      return porIdioma is map &&
        porIdioma.keys().hasOnly(["en", "es", "it", "fr", "ja", "zh", "de", "ko"]) &&
        planoDoIdiomaValido(porIdioma, "en") && planoDoIdiomaValido(porIdioma, "es") &&
        planoDoIdiomaValido(porIdioma, "it") && planoDoIdiomaValido(porIdioma, "fr") &&
        planoDoIdiomaValido(porIdioma, "ja") && planoDoIdiomaValido(porIdioma, "zh") &&
        planoDoIdiomaValido(porIdioma, "de") && planoDoIdiomaValido(porIdioma, "ko");
    }

    function planoValido(plano) {
      return plano.keys().hasOnly(["professorId", "aulasPorSemana", "reposicoesConcedidas", "porIdioma"]) &&
        plano.professorId == request.auth.uid &&
        numerosDoPlanoValidos(plano) &&
        (!("porIdioma" in plano) || porIdiomaValido(plano.porIdioma));
    }

    // Links da sala de aula (aula online e documentos): só http(s) — impede um
    // "javascript:..." que rodaria código ao ser clicado.
    function linkValido(url) {
      return url is string && url.size() <= 2000 && url.matches('https?://[^\\s]+');
    }

    function tituloDocumentoValido(titulo) {
      return titulo is string && titulo.size() > 0 && titulo.size() <= 200;
    }

    // Documento da aula: um link, ou um arquivo enviado pelo professor. O arquivo
    // fica guardado no próprio Firestore, em pedaços ("partes", até 10 MB no total) —
    // o Firebase Storage exigiria o plano pago (com cartão).
    function documentoAulaValido(d) {
      return tituloDocumentoValido(d.titulo) && (
        (d.keys().hasOnly(["titulo", "url", "professorId", "criadoEm"]) && linkValido(d.url)) ||
        (d.keys().hasOnly(["titulo", "professorId", "criadoEm", "nomeArquivo", "tipoArquivo", "tamanho", "partes"]) &&
          d.nomeArquivo is string && d.nomeArquivo.size() > 0 && d.nomeArquivo.size() <= 200 &&
          d.tipoArquivo is string && d.tipoArquivo.size() <= 200 &&
          d.tamanho is int && d.tamanho > 0 && d.tamanho <= 10485760 &&
          d.partes is int && d.partes >= 1 && d.partes <= 12)
      );
    }

    match /usuarios/{userId} {
      // Leitura: o próprio dono, o professor vinculado a esse aluno, ou o aluno
      // vinculado a esse professor (o aluno lê o perfil do professor pra saber quais
      // idiomas ele ensina). O cadastro do aluno não precisa mais ler perfis de
      // professores: ele resolve o código pela coleção "codigosProfessor".
      //
      // O segundo termo usa "resource.data...professorId" direto (não a função
      // ehProfessorDoAluno, que faz um get() no MESMO documento por um caminho
      // variável) de propósito: o painel do professor lista os alunos vinculados
      // com uma CONSULTA (where tipo==aluno, where professorId==X), não uma
      // leitura de documento único. Pra consultas, o Firestore só consegue
      // validar a regra sem rodar contra cada documento se ela depender só de
      // "resource.data" (ou de um get() num caminho FIXO, que não é o caso do
      // "get(usuarios/$(alunoId))" quando alunoId muda a cada documento
      // candidato) — com o get() variável, a consulta inteira era recusada com
      // "permission-denied" mesmo com os alunos corretamente vinculados, e a
      // lista do professor ficava sempre vazia.
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        resource.data.get('professorId', null) == request.auth.uid ||
        souAlunoDesteProfessor(userId)
      );

      // Criação: só o próprio usuário, e só com um "tipo" válido — evita que alguém
      // grave um valor arbitrário nesse campo (ex: "admin").
      //
      // Perfis novos só com login do Google: o e-mail da conta é comprovadamente da
      // pessoa. Contas antigas de e-mail e senha já têm perfil e continuam funcionando;
      // uma conta nova de e-mail e senha (criada por fora do app) não consegue perfil.
      allow create: if request.auth != null && request.auth.uid == userId &&
        request.auth.token.firebase.sign_in_provider == "google.com" &&
        request.resource.data.tipo in ["aluno", "professor"] &&
        !("plano" in request.resource.data) &&
        vinculoValido(request.resource.data);

      // Atualização — três situações permitidas:
      // 1) o próprio dono, impedido de alterar os campos sensíveis que definem seu
      //    papel (tipo, codigoProfessor) — sem isso, um aluno poderia se autopromover
      //    a "professor" pelo console do navegador. O professorId só muda junto com
      //    um codigoVinculo que aponte pro novo professor (troca de professor com
      //    código válido), ou pra ficar sem professor.
      // 2) o professor atualmente vinculado ao aluno, mas só pra ZERAR o professorId
      //    (função "Remover aluno" do painel) — todo o resto do perfil do aluno
      //    (nome, e-mail, tipo, codigoProfessor) tem que continuar exatamente igual.
      // 3) o professor vinculado define o plano do aluno (aulas por semana e
      //    reposições) — e só isso; o aluno nunca mexe no próprio plano.
      allow update: if request.auth != null && (
        (request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["plano"]) &&
          request.resource.data.tipo == resource.data.tipo &&
          request.resource.data.get('codigoProfessor', null) == resource.data.get('codigoProfessor', null) &&
          (request.resource.data.get('professorId', null) == resource.data.get('professorId', null) ||
            vinculoValido(request.resource.data))) ||

        (resource.data.get('professorId', null) == request.auth.uid &&
          request.resource.data.get('professorId', null) == null &&
          request.resource.data.tipo == resource.data.tipo &&
          request.resource.data.nome == resource.data.nome &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.get('codigoProfessor', null) == resource.data.get('codigoProfessor', null)) ||

        (resource.data.get('professorId', null) == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["plano"]) &&
          planoValido(request.resource.data.plano))
      );

      allow delete: if request.auth != null && request.auth.uid == userId;

      // Palavras: só o próprio aluno pode ler/escrever suas palavras.
      // O professor vinculado pode LER (para acompanhar o progresso), mas não editar.
      match /palavras/{palavraId} {
        allow read: if request.auth != null &&
          (request.auth.uid == userId || ehProfessorDoAluno(userId));
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Mensagens: o aluno só pode LER (e apagar, ao excluir a própria conta).
      // Só o professor vinculado pode ESCREVER (inclui editar/excluir).
      match /mensagens/{mensagemId} {
        allow read: if request.auth != null &&
          (request.auth.uid == userId || ehProfessorDoAluno(userId));
        allow create, update, delete: if request.auth != null && ehProfessorDoAluno(userId);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Anotações pessoais: o aluno lê/escreve. O professor vinculado só pode LER (acompanhamento).
      match /anotacoes/{anotacaoId} {
        allow read: if request.auth != null &&
          (request.auth.uid == userId || ehProfessorDoAluno(userId));
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Sala de aula: o link da aula online (doc "link"), deixado pelo professor
      // vinculado. O aluno só lê (e apaga, ao excluir a própria conta).
      match /salaDeAula/{docId} {
        allow read: if request.auth != null &&
          (request.auth.uid == userId || ehProfessorDoAluno(userId));
        allow create, update: if request.auth != null && docId == "link" &&
          ehProfessorDoAluno(userId) &&
          request.resource.data.keys().hasOnly(["url", "professorId", "atualizadoEm"]) &&
          linkValido(request.resource.data.url) &&
          request.resource.data.professorId == request.auth.uid;
        allow delete: if request.auth != null &&
          (request.auth.uid == userId || ehProfessorDoAluno(userId));
      }

      // Documentos usados em aula (título + link ou arquivo), adicionados pelo professor
      // vinculado. Cada documento tem um bloco de anotações do aluno sobre ele
      // ("anotacao"): o aluno escreve, o professor só lê — como o vocabulário.
      // O professor não mexe na anotação; o aluno não mexe no documento.
      match /documentosAula/{documentoId} {
        allow read: if request.auth != null &&
          (request.auth.uid == userId || ehProfessorDoAluno(userId));
        allow create: if request.auth != null && ehProfessorDoAluno(userId) &&
          documentoAulaValido(request.resource.data) &&
          request.resource.data.professorId == request.auth.uid;
        allow update: if request.auth != null && (
          (ehProfessorDoAluno(userId) &&
            resource.data.professorId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["titulo", "url"]) &&
            tituloDocumentoValido(request.resource.data.titulo) &&
            (!("url" in request.resource.data) || linkValido(request.resource.data.url))) ||

          (request.auth.uid == userId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["anotacao", "anotacaoEm"]) &&
            request.resource.data.get('anotacao', '') is string &&
            request.resource.data.get('anotacao', '').size() <= 5000)
        );
        allow delete: if request.auth != null &&
          (request.auth.uid == userId || ehProfessorDoAluno(userId));

        // Pedaços (até ~900 KB cada) do arquivo enviado. São gravados antes do
        // documento, que só aparece pro aluno depois do arquivo inteiro enviado.
        match /partes/{parteId} {
          allow read: if request.auth != null &&
            (request.auth.uid == userId || ehProfessorDoAluno(userId));
          allow create: if request.auth != null && ehProfessorDoAluno(userId) &&
            request.resource.data.keys().hasOnly(["dados", "indice"]) &&
            request.resource.data.dados is bytes && request.resource.data.dados.size() <= 950000 &&
            request.resource.data.indice is int && request.resource.data.indice >= 0 && request.resource.data.indice < 12;
          allow delete: if request.auth != null &&
            (request.auth.uid == userId || ehProfessorDoAluno(userId));
        }
      }

      // Relatório de aulas: o "diário de bordo" do professor sobre o que foi trabalhado
      // em cada aula. É registro do professor, não do aluno — só ele lê e escreve.
      match /relatorios/{relatorioId} {
        allow read, write: if request.auth != null && ehProfessorDoAluno(userId);
      }

      // Notificações (o sino). Do aluno: "você recebeu 1 crédito de reposição", "seu
      // pedido de reposição foi aprovado"... — só o professor vinculado cria. Do
      // professor: "aluno marcou/cancelou uma aula", "pediu reposição" — só um aluno
      // vinculado a ele cria, em nome de si mesmo. Sempre com tipo e texto controlados;
      // o dono lê, marca como lida e apaga as dele.
      match /notificacoes/{notificacaoId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lida"]);
        allow create: if request.auth != null &&
          request.resource.data.texto is string && request.resource.data.texto.size() <= 300 &&
          request.resource.data.lida == false && (
          (ehProfessorDoAluno(userId) &&
            request.resource.data.keys().hasOnly(["tipo", "texto", "criadoEm", "lida", "professorId", "idioma"]) &&
            request.resource.data.tipo in ["credito-reposicao", "reposicao-aprovada", "reposicao-recusada",
              "aula-nao-realizada", "aula-marcada"] &&
            request.resource.data.professorId == request.auth.uid) ||

          (souAlunoDesteProfessor(userId) &&
            request.resource.data.keys().hasOnly(["tipo", "texto", "criadoEm", "lida", "alunoId", "idioma"]) &&
            request.resource.data.tipo in ["aluno-marcou-aula", "aluno-cancelou-aula", "aluno-pediu-reposicao"] &&
            request.resource.data.alunoId == request.auth.uid)
        );
      }

      // Controle de "última visualização": usado só pelo próprio professor, para saber
      // quais alunos/letras têm palavras novas desde a última vez que ele abriu o bloco.
      match /visualizacoes/{alunoId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Configuração de agenda do professor (dias/horários que atende, duração da aula,
      // modalidades). Só o próprio professor escreve; alunos vinculados só leem, para
      // montar a tela de "horários disponíveis" na hora de agendar.
      match /configuracaoAgenda/{docId} {
        allow read: if request.auth != null &&
          (request.auth.uid == userId || souAlunoDesteProfessor(userId));
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Exceções pontuais de disponibilidade por dia (fechar um dia específico, ou
      // ajustar o horário só dele), além da grade semanal recorrente acima. Mesma
      // regra de leitura/escrita da configuração de agenda.
      match /agendaOverrides/{dataId} {
        allow read: if request.auth != null &&
          (request.auth.uid == userId || souAlunoDesteProfessor(userId));
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Alunos sem app: cadastrados pelo próprio professor (nome, telefone, idioma que
      // estudam e créditos de reposição nesse idioma), pra ele marcar as aulas de quem
      // não consegue usar o app. Só o professor lê e escreve.
      match /alunosSemApp/{alunoSemAppId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId &&
          request.resource.data.keys().hasOnly(["nome", "telefone", "idioma", "reposicoesConcedidas", "criadoEm"]) &&
          request.resource.data.nome is string && request.resource.data.nome.size() > 0 &&
          request.resource.data.nome.size() <= 100 &&
          request.resource.data.reposicoesConcedidas is int &&
          request.resource.data.reposicoesConcedidas >= 0 && request.resource.data.reposicoesConcedidas <= 1000;
      }

      // Anotações privadas do professor sobre dias e aulas da agenda (calendário
      // de anotações). Só o próprio professor lê e escreve — nem o aluno vê.
      match /anotacoesAgenda/{notaId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Aulas agendadas. Coleção no nível raiz (não dentro de "usuarios") porque tanto o
    // professor (todas as aulas da sua agenda) quanto o aluno (só as próprias) precisam
    // consultar por igualdade de campo, sem depender de quem é "dono" do documento pai.
    //
    // O ID do documento é determinístico: "{professorId}_{data}_{horaInicio}". Isso é o
    // que garante que dois alunos não consigam marcar o mesmo horário ao mesmo tempo — a
    // segunda tentativa de escrita cai como "update" de um doc que já existe com
    // status "agendada", e a regra de update abaixo barra isso.
    // Status de uma aula ao ser marcada: "agendada" (normal, ou reposição com crédito)
    // ou "pendente" — pedido de reposição sem crédito, que espera o professor aprovar
    // (vira "agendada") ou recusar (vira "recusada"). O pedido já reserva o horário.
    function statusNovoValido(d) {
      return d.status == "agendada" || (d.status == "pendente" && d.reposicao == true);
    }

    // Aula marcada pelo próprio professor: pra um aluno vinculado a ele ou pra um
    // aluno sem app cadastrado por ele.
    function aulaMarcadaPeloProfessorValida(d) {
      return d.professorId == request.auth.uid &&
        d.status == "agendada" &&
        d.modalidade in ["online", "presencial"] &&
        (ehProfessorDoAluno(d.alunoId) ||
          exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)/alunosSemApp/$(d.alunoId)));
    }

    match /aulas/{aulaId} {
      // Leitura: o professor da aula, o aluno da aula, OU qualquer aluno vinculado
      // a esse mesmo professor — esse terceiro caso é o que faltava: na hora de
      // agendar, o aluno consulta TODAS as aulas do professor num dia (where
      // professorId==X, where data==Y) pra descobrir quais horários já estão
      // ocupados, incluindo os marcados por OUTROS alunos (o app só lê o campo
      // "horaInicio" dessas, nunca exibe nome de outro aluno). Sem essa terceira
      // condição, essa consulta batia num "permission-denied" (o Firestore não
      // consegue provar que os dois primeiros termos cobrem TODO resultado
      // possível da busca) e a tela ficava travada em "Carregando horários..."
      // pra sempre.
      //
      // "resource == null ||" no início cobre outro caso: agendarAula() roda
      // tx.get(ref) num ID de documento determinístico ANTES de criar a aula,
      // só pra checar se aquele horário exato já está ocupado. Na primeiríssima
      // vez que qualquer horário é marcado, esse documento ainda não existe —
      // e sem esse "resource == null", o Firestore tenta avaliar
      // "resource.data.professorId" num resource inexistente, o que falha e
      // nega a leitura. Não há nada a proteger num documento que não existe
      // (a resposta é só "não existe"), então liberar esse caso é seguro.
      allow read: if request.auth != null &&
        (resource == null ||
          resource.data.professorId == request.auth.uid ||
          resource.data.alunoId == request.auth.uid ||
          souAlunoDesteProfessor(resource.data.professorId));

      // Criação (primeira marcação daquele horário): só o próprio aluno, e só com o
      // professor ao qual ele está vinculado — impede marcar aula com outro professor.
      // O professor também cria aulas, pros alunos dele (inclusive os sem app).
      allow create: if request.auth != null && (
        (request.resource.data.alunoId == request.auth.uid &&
          statusNovoValido(request.resource.data) &&
          request.resource.data.modalidade in ["online", "presencial"] &&
          souAlunoDesteProfessor(request.resource.data.professorId)) ||
        aulaMarcadaPeloProfessorValida(request.resource.data)
      );

      // Atualização — quatro situações permitidas:
      // 1) o professor muda o status (cancelar/concluir/não realizada), sem alterar quem/quando é a aula;
      // 2) o próprio aluno cancela a aula que é dele, sem mudar mais nada;
      // 3) reaproveitar um horário cancelado: outro aluno vinculado ao MESMO professor pode
      //    "reocupar" aquele exato horário, virando o novo dono da aula;
      // 4) o professor reaproveita um horário cancelado dele, marcando ali a aula de um aluno.
      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.professorId &&
          request.resource.data.professorId == resource.data.professorId &&
          request.resource.data.alunoId == resource.data.alunoId &&
          request.resource.data.data == resource.data.data &&
          request.resource.data.horaInicio == resource.data.horaInicio) ||

        (request.auth.uid == resource.data.alunoId &&
          resource.data.status in ["agendada", "pendente"] &&
          request.resource.data.status == "cancelada" &&
          request.resource.data.professorId == resource.data.professorId &&
          request.resource.data.alunoId == resource.data.alunoId &&
          request.resource.data.data == resource.data.data &&
          request.resource.data.horaInicio == resource.data.horaInicio) ||

        (resource.data.status in ["cancelada", "recusada"] &&
          statusNovoValido(request.resource.data) &&
          request.resource.data.modalidade in ["online", "presencial"] &&
          request.resource.data.alunoId == request.auth.uid &&
          request.resource.data.professorId == resource.data.professorId &&
          request.resource.data.data == resource.data.data &&
          request.resource.data.horaInicio == resource.data.horaInicio &&
          souAlunoDesteProfessor(resource.data.professorId)) ||

        (resource.data.status in ["cancelada", "recusada"] &&
          resource.data.professorId == request.auth.uid &&
          aulaMarcadaPeloProfessorValida(request.resource.data) &&
          request.resource.data.data == resource.data.data &&
          request.resource.data.horaInicio == resource.data.horaInicio)
      );

      // Sem "delete": cancelamento é só uma troca de status, mantendo o histórico da aula.
    }
  }
}
